PORT=5000
MONGO_URI=mongodb://localhost:27017/devops-copilot
JWT_SECRET=replace-with-a-random-secret-string
GITHUB_CLIENT_ID=replace-with-your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
LLM_API_KEY=replace-with-your-anthropic-api-key
LLM_API_URL=https://api.anthropic.com/v1/messages
PROMETHEUS_URL=http://localhost:9090
CLIENT_URL=http://localhost:3000

# Kubernetes API access for the self-healing controller.
# K8S_API_URL: your cluster's API server (e.g. from `kubectl cluster-info`)
# K8S_TOKEN: a service-account token scoped to the devops-copilot namespace
# only - never a cluster-admin token. Generate with:
#   kubectl create serviceaccount devops-copilot-sa -n devops-copilot
#   kubectl create token devops-copilot-sa -n devops-copilot
# Leave both blank to run against the local demo-cache fallback only.
K8S_API_URL=
K8S_TOKEN=
