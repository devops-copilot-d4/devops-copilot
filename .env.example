# Copy to .env and supply values through your local secret manager or CI/CD secrets.
# Do not commit a populated .env file.

PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/devops-copilot
JWT_SECRET=replace-with-a-long-random-secret

# External cluster mode requires both values. In-cluster mode reads the mounted
# service-account token and CA automatically.
K8S_API_URL=https://your-kubernetes-api-server:6443
K8S_TOKEN=replace-with-kubernetes-service-account-token
K8S_TIMEOUT_MS=5000
# Rollout tracking (used by the backend deployment integration)
K8S_ROLLOUT_TIMEOUT_MS=180000
K8S_ROLLOUT_POLL_MS=5000

# Docker Hub container registry configuration
DOCKERHUB_USERNAME=tharungowda
IMAGE_REGISTRY=docker.io

# GitHub integration (OAuth app credentials - set via CI/CD secrets in production)
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_MS=1500
PROMETHEUS_TELEMETRY_WINDOW=5m
# %SERVICE% and %NAMESPACE% are replaced from the registered Service record.
PROMETHEUS_SERVICE_SELECTOR_TEMPLATE=job="%SERVICE%"
# Override individual PromQL expressions only when your Prometheus labels differ.
# PROMQL_CPU_USAGE=
# PROMQL_MEMORY_USAGE=
# PROMQL_POD_RESTARTS=
# PROMQL_REQUEST_COUNT=
# PROMQL_REQUEST_RATE=
# PROMQL_ERROR_RATE=
# PROMQL_P95_LATENCY=
# PROMQL_TARGET_AVAILABILITY=
K8S_LOG_TAIL_LINES=200
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=6000

# Explicitly opt in only for isolated synthetic demo fixtures.
SIMULATION_MODE=false

LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-4o-mini
